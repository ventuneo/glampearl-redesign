---
import Base from '../../layouts/Base.astro';
import ShopGrid from '../../components/ShopGrid.astro';
import { CATEGORIES, inCategory, money } from '../../lib/catalog';

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { category: c.slug }, props: { category: c } }));
}
const { category: c } = Astro.props;
const list = inCategory(c.slug);
const from = Math.min(...list.map((p) => p.priceMin));
const title = c.name.charAt(0).toUpperCase() + c.name.slice(1);
---

<Base title={title} description={`${c.line} ${list.length} products from ${money(from)}.`} current={c.slug}>
  <ShopGrid title={c.name} line={c.line} list={list} current={c.slug} />
</Base>
