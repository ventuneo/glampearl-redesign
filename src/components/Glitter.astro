---
// A product photograph as pastel glitter (built by scripts/glitter.mjs). The flakes are a still image;
// scripts/glitter.ts draws the sparkles on a canvas above it. Decorative: hidden from assistive tech.
import art from '../data/glitter.json';

interface Props {
  name: keyof typeof art;
  class?: string;
  sizes?: string;
  eager?: boolean;
}
const { name, class: cls = '', sizes = '50vw', eager = false } = Astro.props;
const a = art[name];
const widths = name === 'hero' ? [420, 600, 1080] : [720, 1440];
---

<div class:list={['glitter', cls]} aria-hidden="true" data-glitter={name} style={`aspect-ratio:${a.w} / ${a.h}`}>
  <picture>
    <!-- phones always get the 600 px file: dense screens would otherwise pull the large one, and soft
         flakes are fine there (keeps the first screen fast on a slow phone) -->
    {name === 'hero' && <source media="(max-width: 899px)" srcset={`/art/${name}-600.webp`} />}
    <img
    src={`/art/${name}-${widths.at(-1)}.webp`}
    srcset={widths.map((w) => `/art/${name}-${w}.webp ${w}w`).join(', ')}
    sizes={sizes}
    width={a.w}
    height={a.h}
    alt=""
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding="async"
    />
  </picture>
  <canvas></canvas>
</div>
<script type="application/json" data-glitter-map={name} set:html={JSON.stringify({ cols: a.cols, rows: a.rows, d: a.d })} />

<style is:global>
  .glitter {
    position: relative;
    user-select: none;
    -webkit-user-select: none;
  }
  .glitter img,
  .glitter picture,
  .glitter canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .glitter canvas {
    pointer-events: none;
  }
</style>
