---
// Newsletter, navigation and legal on the dark ground, the press-on nails as a glyph field, the wordmark in pearls.
// Shopify port: sections/footer.liquid (newsletter form + menus + the two decorative snippets).
import { CATEGORIES, STORE } from '../lib/catalog';
import Wordmark from './Wordmark.astro';
import Glitter from './Glitter.astro';
import Cta from './Cta.astro';
const year = new Date().getFullYear();
const nav = [
  { href: '/', label: 'Home' },
  { href: '/shop', label: 'Shop all' },
  ...CATEGORIES.map((c) => ({ href: `/shop/${c.slug}`, label: c.name[0].toUpperCase() + c.name.slice(1) })),
  { href: '/help', label: 'Help' },
];
---

<footer class="foot" data-theme="pearl">
  <div class="foot__top wrap">
    <section class="foot__signup" id="newsletter" aria-labelledby="signup-title">
      <h2 class="foot__h" id="signup-title">10% off your first order, and new shades by email.</h2>
      <!-- Posts to the live store's standard Shopify customer form (newsletter tag), as the theme does today. -->
      <form class="signup__form" data-signup method="post" action={`${STORE}/contact#newsletter`} accept-charset="UTF-8" novalidate>
        <input type="hidden" name="form_type" value="customer" />
        <input type="hidden" name="utf8" value="✓" />
        <input type="hidden" name="contact[tags]" value="newsletter" />
        <label class="visually-hidden" for="signup-email">Email address</label>
        <input id="signup-email" name="contact[email]" type="email" autocomplete="email" inputmode="email" placeholder="Email address" required />
        <Cta type="submit" variant="light">Sign up</Cta>
        <p class="signup__msg label muted" data-signup-msg role="status" aria-live="polite">No spam. Unsubscribe any time.</p>
      </form>
    </section>
    <nav class="foot__nav" aria-label="Footer">
      <ul role="list">
        {
          nav.map((l) => (
            <li>
              <a class="label" href={l.href}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="foot__contact">
      <p><a class="u-grow" href="mailto:support@glampearl.store">support@glampearl.store</a></p>
      <p class="muted">Orders, returns and shades.</p>
      <ul role="list" class="foot__legal">
        <li><a class="u-grow" href={`${STORE}/policies/privacy-policy`}>Privacy policy</a></li>
        <li><a class="u-grow" href={`${STORE}/policies/terms-of-service`}>Terms of service</a></li>
        <li><a class="u-grow" href={`${STORE}/policies/refund-policy`}>Refund policy</a></li>
      </ul>
    </div>
  </div>

  <div class="foot__art">
    <Glitter name="footer" class="foot__ascii" sizes="100vw" />
    <div class="foot__status label">
      <p><span class="mark" aria-hidden="true"></span> Tracked delivery</p>
      <p><span class="mark" aria-hidden="true"></span> Card and Apple Pay at checkout</p>
    </div>
    <p class="foot__copy t-s">
      © {year} GlamPearl.<br />
      <span class="muted">Product names and logos are trademarks of their owners.</span>
    </p>
  </div>
  <div class="foot__mark wrap"><Wordmark r={0.46} /></div>
</footer>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-signup]');
  const msg = document.querySelector<HTMLElement>('[data-signup-msg]');
  form?.addEventListener('submit', (e) => {
    const input = form.querySelector<HTMLInputElement>('input[type="email"]')!;
    if (!input.checkValidity()) {
      e.preventDefault();
      msg!.textContent = 'Enter an email address like name@example.com.';
      input.setAttribute('aria-invalid', 'true');
      input.focus();
      return;
    }
    input.removeAttribute('aria-invalid');
  });
</script>

<style>
  .foot {
    position: relative;
    overflow: hidden;
    padding-top: var(--s8);
  }
  .foot__top {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--s7) var(--s6);
  }
  @media (min-width: 900px) {
    .foot__top {
      grid-template-columns: minmax(0, 5fr) minmax(0, 3fr) minmax(0, 4fr);
    }
  }
  .foot__h {
    font-family: var(--display);
    font-size: var(--t-h3);
    font-weight: 400;
    letter-spacing: -0.015em;
    line-height: 1.25;
    max-width: 22rem;
    margin-bottom: var(--s4);
  }
  .signup__form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 4px;
    max-width: 30rem;
  }
  .signup__form input[type='email'] {
    min-height: 44px;
    padding: 0 14px;
    border: 0;
    background: #ffffff;
    border-radius: 999px;
    color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--line);
    transition: box-shadow var(--d-ui) ease;
  }
  .signup__form input::placeholder {
    color: var(--muted);
  }
  .signup__form input:focus-visible {
    outline: none;
    box-shadow: inset 0 0 0 2px var(--rose);
  }
  .signup__form input[aria-invalid='true'] {
    box-shadow: inset 0 0 0 2px var(--rose);
  }
  .signup__msg {
    grid-column: 1 / -1;
    min-height: 1.5em;
    margin-top: var(--s2);
  }
  .foot__nav ul {
    display: grid;
    gap: 2px;
    margin: 0;
  }
  @media (min-width: 900px) {
    .foot__nav ul {
      justify-items: center;
    }
  }
  .foot__nav a {
    display: inline-block;
    padding-block: 5px;
    text-decoration: none;
    transition: color 160ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .foot__nav a:hover {
      color: var(--rose);
    }
  }
  .foot__contact {
    display: grid;
    align-content: start;
    gap: var(--s1);
    font-size: var(--t-s);
  }
  @media (min-width: 900px) {
    .foot__contact {
      justify-items: end;
      text-align: right;
    }
  }
  .foot__legal {
    display: grid;
    gap: 0;
    margin: var(--s4) 0 0;
  }
  @media (min-width: 900px) {
    .foot__legal {
      justify-items: end;
    }
  }
  .foot__art {
    position: relative;
    margin-top: var(--s6);
    min-height: 20rem;
  }
  .foot :global(.foot__ascii) {
    position: relative;
    width: min(100%, 68rem);
    margin-inline: auto;
  }
  .foot__status {
    position: absolute;
    left: var(--m);
    top: 0;
    display: grid;
    gap: 4px;
  }
  .foot__status p {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .foot__status .mark {
    width: 7px;
    height: 7px;
  }
  .foot__copy {
    position: absolute;
    left: 50%;
    bottom: var(--s6);
    translate: -50% 0;
    width: max-content;
    max-width: calc(100% - 2 * var(--m));
    text-align: center;
    padding: 8px 12px;
    background: rgb(255 255 255 / 0.7);
    border-radius: 999px;
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }
  .foot__mark {
    color: #efd7e3;
    padding-bottom: calc(var(--s4) + env(safe-area-inset-bottom, 0px));
  }
  .foot__mark :global(.wordmark-dots) {
    width: 100%;
    height: auto;
  }
  @media (max-width: 899px) {
    .foot__art {
      min-height: 0;
      padding-top: 4.5rem;
    }
    .foot__copy {
      position: relative;
      left: auto;
      bottom: auto;
      translate: none;
      margin: var(--s4) var(--m) 0;
      text-align: left;
      padding: 0;
      background: none;
    }
  }
</style>
