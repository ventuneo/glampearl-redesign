---
// The floating bar: wordmark, menu, search and the bag. It takes the colour of the section under it.
// Shopify port: sections/header.liquid (+ the announcement moves into the menu and the footer).
import Wordmark from './Wordmark.astro';
---

<header class="bar">
  <div class="bar__inner">
    <a class="bar__mark" href="/" aria-label="GlamPearl, home">
      <Wordmark />
    </a>
    <button class="bar__menu label" type="button" data-open-menu aria-haspopup="dialog" aria-controls="menu">
      <span>Menu</span>
      <svg aria-hidden="true" width="14" height="10" viewBox="0 0 14 10" fill="none"><path d="M0 2.5h14M0 7.5h14" stroke="currentColor" stroke-width="1.4"></path></svg>
    </button>
    <div class="bar__actions">
      <button class="bar__search label" type="button" data-open-search aria-haspopup="dialog">
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 20 20" fill="none"><circle cx="8.5" cy="8.5" r="6" stroke="currentColor" stroke-width="1.8"></circle><path d="m13 13 4.5 4.5" stroke="currentColor" stroke-width="1.8"></path></svg>
        <span class="bar__search-label">Search</span>
      </button>
      <button class="cta bar__bag" type="button" data-open-bag aria-haspopup="dialog">
        <span class="cta__label">Bag</span>
        <span class="cta__sq bar__count num" data-bag-count aria-label="0 items">0</span>
      </button>
    </div>
  </div>
</header>

<style is:global>
  .bar {
    position: fixed;
    z-index: 40;
    top: var(--bar-top);
    left: var(--m);
    right: var(--m);
    height: var(--bar-h);
    pointer-events: none;
  }
  .bar__inner {
    --bar-bg: rgb(255 255 255 / 0.62);
    --bar-fg: var(--plum);
    pointer-events: auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 100%;
    padding: 0 4px 0 20px;
    border-radius: 999px;
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.7),
      0 10px 30px rgb(163 69 110 / 0.08);
    background: var(--bar-bg);
    color: var(--bar-fg);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    backdrop-filter: blur(14px) saturate(1.2);
    transition:
      background-color 320ms var(--ease-out),
      color 320ms var(--ease-out);
  }
  .bar :focus-visible,
  .menu__bar :focus-visible {
    outline-color: var(--bar-fg, #3a2e39);
  }
  :root[data-bar='haze'] .bar__inner {
    --bar-bg: rgb(255 255 255 / 0.72);
  }
  .bar__mark {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 15px;
    color: inherit;
  }
  @media (hover: hover) and (pointer: fine) {
    .bar__mark:hover .wordmark-dots circle {
      scale: 0.45;
    }
  }
  .bar__menu,
  .bar__search {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 12px;
    color: inherit;
    transition: transform var(--d-press) var(--ease-out);
  }
  .bar__menu:active,
  .bar__search:active {
    transform: scale(0.96);
  }
  .bar__menu svg {
    transition: scale 220ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .bar__menu:hover svg {
      scale: 1 0.4;
    }
    .bar__search:hover svg {
      scale: 1.25;
      rotate: -12deg;
    }
    .bar__search:hover .bar__search-label {
      text-decoration: underline;
      text-underline-offset: 0.35em;
    }
  }
  .bar__search svg {
    transition: scale 260ms var(--ease-out), rotate 260ms var(--ease-out);
  }
  .bar__actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .bar__bag {
    min-height: 44px;
  }
  .bar__count {
  }
  .bar__count[data-empty] {
    background: #fbe3ec;
  }
  @media (max-width: 599px) {
    .bar__inner {
      padding-left: 12px;
    }
    .bar__mark {
      font-size: 12px;
    }
    .bar__search-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    .bar__search {
      padding: 0 10px;
      min-width: 44px;
      justify-content: center;
    }
    .bar__menu {
      padding: 0 8px;
    }
  }
</style>
