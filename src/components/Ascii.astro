---
// A product photograph as a glyph field (built by scripts/ascii.mjs). Static text first; scripts/ascii.ts
// makes the glyphs flicker at rest and scramble under the pointer. Decorative: hidden from assistive tech.
import art from '../data/ascii.json';

interface Props {
  name: keyof typeof art;
  class?: string;
}
const { name, class: cls = '' } = Astro.props;
const a = art[name];
---

<div class:list={['ascii', cls]} aria-hidden="true" data-ascii style={`--cols:${a.cols};--rows:${a.rows}`}>
  <div class="ascii__grid">{a.lines.map((l) => <div class="ascii__row">{l || ' '}</div>)}</div>
</div>

<style is:global>
  .ascii {
    container-type: inline-size;
    color: var(--signal);
    pointer-events: auto;
    user-select: none;
    -webkit-user-select: none;
  }
  .ascii__grid {
    font-family: var(--mono);
    /* Geist Mono advances 0.6 em, so the field always spans its container exactly. */
    font-size: calc(100cqw / (var(--cols) * 0.6));
    line-height: 1;
    letter-spacing: 0;
    white-space: pre;
    font-variant-ligatures: none;
    font-weight: 500;
  }
  .ascii__row {
    height: 1em;
    contain: layout paint;
  }
</style>
