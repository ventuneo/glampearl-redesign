---
// Bag drawer. Shopify port: snippets/cart-drawer.liquid (items come from the cart object, checkout from routes.cart_url).
---

<dialog class="sheet sheet--right" id="bag" aria-labelledby="bag-title">
  <div class="sheet__inner">
    <div class="sheet__head">
      <h2 class="t-m" id="bag-title">bag <span class="muted num" data-bag-count-text></span></h2>
      <button class="sheet__close" type="button" data-close aria-label="Close bag">
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="m5 5 10 10M15 5 5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
      </button>
    </div>
    <div class="sheet__body" data-bag-body>
      <ul class="bag-list" role="list" data-bag-list></ul>
      <div class="bag-empty" data-bag-empty hidden>
        <p class="t-m">Your bag is empty.</p>
        <p class="muted t-s">Add something from the shop and it will wait here until you check out.</p>
        <a class="btn" href="/shop">See all products</a>
      </div>
    </div>
    <div class="sheet__foot" data-bag-foot>
      <div class="bag-total">
        <span>Subtotal</span>
        <span class="num" data-bag-subtotal>CHF 0.00</span>
      </div>
      <p class="t-xs muted">Taxes included, shipping added at checkout. Orders arrive in about 7 to 20 working days.</p>
      <a class="btn btn--block" data-checkout href="https://glampearl.store/cart">Check out</a>
      <p class="t-xs muted bag-secure">Secure checkout on glampearl.store, with cards and Apple Pay.</p>
    </div>
  </div>
</dialog>
<p class="visually-hidden" role="status" aria-live="polite" data-bag-live></p>

<style is:global>
  html:has(dialog[open]) {
    overflow: hidden;
  }
  .sheet {
    position: fixed;
    margin: 0;
    padding: 0;
    border: 0;
    max-width: none;
    max-height: none;
    background: var(--ground);
    color: var(--ink);
    overscroll-behavior: contain;
  }
  .sheet::backdrop {
    background: rgb(52 48 45 / 0);
    transition:
      background-color 240ms ease,
      overlay 240ms allow-discrete,
      display 240ms allow-discrete;
  }
  .sheet[open]::backdrop {
    background: var(--scrim);
    transition-duration: 360ms;
  }
  @starting-style {
    .sheet[open]::backdrop {
      background: rgb(52 48 45 / 0);
    }
  }
  .sheet--right {
    inset: 0 0 0 auto;
    width: min(440px, 100%);
    height: 100dvh;
    transform: translateX(100%);
    transition:
      transform 240ms var(--ease-out),
      overlay 240ms allow-discrete,
      display 240ms allow-discrete;
  }
  .sheet--right[open] {
    transform: translateX(0);
    transition-duration: 380ms;
    transition-timing-function: var(--ease-drawer);
  }
  @starting-style {
    .sheet--right[open] {
      transform: translateX(100%);
    }
  }
  .sheet__inner {
    display: grid;
    grid-template-rows: auto 1fr auto;
    height: 100%;
    padding-top: env(safe-area-inset-top, 0px);
  }
  .sheet__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s4);
    padding: var(--s4) var(--s5);
    border-bottom: 1px solid var(--line);
  }
  .sheet__close {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    border-radius: 999px;
    transition: background-color var(--d-ui) ease, transform var(--d-press) var(--ease-out);
  }
  .sheet__close:active {
    transform: scale(0.94);
  }
  @media (hover: hover) and (pointer: fine) {
    .sheet__close:hover {
      background: var(--nacre);
    }
  }
  .sheet__body {
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--s4) var(--s5);
  }
  .sheet__foot {
    display: grid;
    gap: var(--s3);
    padding: var(--s5) var(--s5) calc(var(--s5) + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--line);
  }
  .sheet__foot[hidden] {
    display: none;
  }
  .bag-total {
    display: flex;
    justify-content: space-between;
    font-weight: 500;
    font-size: var(--t-m);
  }
  .bag-secure {
    text-align: center;
  }
  .bag-list {
    display: grid;
    gap: var(--s5);
    margin: 0;
  }
  .bag-item {
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr);
    gap: var(--s4);
    align-items: start;
  }
  .bag-item .field {
    width: 76px;
  }
  .bag-item__name {
    font-weight: 500;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .bag-item__variant {
    color: var(--muted);
    font-size: var(--t-s);
    overflow-wrap: anywhere;
  }
  .bag-item__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s3);
    margin-top: var(--s3);
  }
  .qty {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .qty button {
    width: 40px;
    height: 40px;
    display: inline-grid;
    place-items: center;
    border-radius: 999px;
    transition: transform var(--d-press) var(--ease-out), background-color var(--d-ui) ease;
  }
  .qty button:active {
    transform: scale(0.92);
  }
  @media (hover: hover) and (pointer: fine) {
    .qty button:hover {
      background: var(--nacre);
    }
  }
  .qty output {
    min-width: 24px;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .bag-item__remove {
    font-size: var(--t-xs);
    color: var(--muted);
    text-decoration: underline;
    padding: 8px 0;
  }
  .bag-empty {
    display: grid;
    gap: var(--s3);
    justify-items: start;
    padding-block: var(--s6);
  }
  .bag-empty[hidden] {
    display: none;
  }
</style>
