---
// Label block + square block. A link when `href` is set, otherwise a button. Hover trades the two places.
interface Props {
  href?: string;
  variant?: 'signal' | 'ink' | 'light';
  type?: 'button' | 'submit';
  icon?: 'plus' | 'arrow' | 'mail';
  class?: string;
  [key: string]: unknown;
}
const { href, variant = 'signal', type = 'button', icon = 'plus', class: cls = '', ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={['cta', variant !== 'signal' && `cta--${variant}`, cls]}
  href={href}
  type={href ? undefined : type}
  {...rest}
>
  <span class="cta__label"><slot /></span>
  <span class="cta__sq" aria-hidden="true">
    {
      icon === 'plus' && (
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
          <path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.4" />
        </svg>
      )
    }
    {
      icon === 'arrow' && (
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
          <path d="M2 6h8M6.5 2.5 10 6l-3.5 3.5" stroke="currentColor" stroke-width="1.4" />
        </svg>
      )
    }
    {
      icon === 'mail' && (
        <svg width="14" height="12" viewBox="0 0 14 12" fill="none">
          <path d="M1 1.5h12v9H1zM1 1.5l6 5 6-5" stroke="currentColor" stroke-width="1.3" />
        </svg>
      )
    }
  </span>
</Tag>
