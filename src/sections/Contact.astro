---
// Write to us: a photograph from the shop, the address and one button. Shopify port: sections/contact-split.liquid.
import Cta from '../components/Cta.astro';
import { byHandle } from '../lib/catalog';
const mask = byHandle('collagen-moisturizing-facial-mask')!;
const photo = mask.images[1] ?? mask.images[0];
---

<section class="contact wrap" data-theme="light" aria-labelledby="contact-title">
  <h2 class="t-l contact__title" id="contact-title">Write to us.</h2>
  <p class="contact__lead">Questions about an order, a return or the right shade? A person reads every message.</p>
  <a class="contact__photo" href={`/products/${mask.handle}`} style={`background:${photo.e1}`}>
    <img src={photo.src['960']} srcset={`${photo.src['480']} 480w, ${photo.src['960']} 960w`} sizes="(min-width: 900px) 40vw, 100vw" width="960" height="960" alt={`${mask.name}: ${mask.line}`} loading="lazy" decoding="async" />
  </a>
  <div class="contact__how">
    <p class="t-s">
      <a class="u-grow" href="mailto:support@glampearl.store">support@glampearl.store</a>
      <br /><span class="muted">Add your order number if you have one.</span>
    </p>
    <div class="contact__actions">
      <Cta href="mailto:support@glampearl.store" variant="ink" icon="mail">Email support</Cta>
      <a class="contact__link mono" href="/help">Delivery and returns</a>
    </div>
  </div>
</section>

<style>
  .contact {
    display: grid;
    gap: var(--s6) var(--gap);
    padding-block: var(--s9);
  }
  @media (min-width: 900px) {
    .contact {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: auto 1fr;
    }
    .contact__title {
      grid-column: 1 / 6;
    }
    .contact__lead {
      grid-column: 8 / 13;
    }
    .contact__photo {
      grid-column: 1 / 6;
    }
    .contact__how {
      grid-column: 8 / 12;
      align-self: start;
    }
  }
  .contact__lead {
    font-size: clamp(1.4rem, 1.1rem + 0.9vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.15;
    max-width: 24rem;
  }
  .contact__photo {
    display: block;
    aspect-ratio: 5 / 4;
    overflow: hidden;
  }
  .contact__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 800ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .contact__photo:hover img {
      scale: 1.04;
    }
  }
  .contact__how {
    display: grid;
    gap: var(--s5);
  }
  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s4) var(--s5);
  }
  .contact__link {
    padding-block: 4px;
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  @media (hover: hover) and (pointer: fine) {
    .contact__link:hover {
      color: var(--signal-ink);
    }
  }
</style>
