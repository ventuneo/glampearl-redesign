---
// Three plain facts in place of testimonials. Numbers are the live shop's (Judge.me totals, returns policy).
// Shopify port: sections/facts.liquid (reviews from the Judge.me metafields).
import { products, reviewTotals } from '../lib/catalog';
const { count, average } = reviewTotals();
const lowest = Math.min(...products.map((p) => p.priceMin));
---

<section class="section wrap facts" aria-labelledby="facts-title">
  <h2 class="visually-hidden" id="facts-title">Reviews, returns and checkout</h2>
  <dl class="facts__list">
    <div>
      <dt class="t-display num">{average.toFixed(1)}</dt>
      <dd>out of 5, the average of {count} product reviews</dd>
    </div>
    <div>
      <dt class="t-display num">30 days</dt>
      <dd>to send back unused items in their packaging</dd>
    </div>
    <div>
      <dt class="t-display num">CHF&nbsp;{lowest.toFixed(2)}</dt>
      <dd>is where prices start, taxes included, paid by card or Apple Pay</dd>
    </div>
  </dl>
</section>

<style>
  .facts {
    border-top: 1px solid var(--line);
  }
  .facts__list {
    display: grid;
    gap: var(--s7) var(--gap);
  }
  @media (min-width: 900px) {
    .facts__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .facts__list div {
    display: grid;
    gap: var(--s3);
    align-content: start;
  }
  .facts__list dt {
    margin-left: -0.04em;
  }
  .facts__list dd {
    margin: 0;
    color: var(--muted);
    max-width: 22rem;
  }
</style>
